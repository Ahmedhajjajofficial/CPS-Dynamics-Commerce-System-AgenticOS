{
  "name": "CP'S Dynamics Commerce System AgenticOS",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "PATH": "/opt/venv/bin:/usr/local/go/bin:/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "GOPATH": "/go",
    "PYTHONPATH": "/workspaces/cps-dynamics-agenticos"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/cps-dynamics-agenticos,type=bind",
  "workspaceFolder": "/workspaces/cps-dynamics-agenticos",
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "forwardPorts": [
    3000,
    5173,
    5432,
    6379,
    9092,
    8200,
    3001,
    9090,
    50051,
    50052
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.analysis.extraPaths": [
          "/workspaces/cps-dynamics-agenticos/cps-enterprise-dcs/local-agent/src"
        ],
        "go.gopath": "/go",
        "go.toolsManagement.autoUpdate": true,
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.organizeImports": "explicit"
        },
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": false,
        "python.linting.ruffEnabled": true
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "golang.go",
        "ms-python.python",
        "ms-python.black-formatter",
        "charliermarsh.ruff",
        "zxh404.vscode-proto3",
        "ms-azuretools.vscode-docker",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "redhat.vscode-yaml",
        "github.vscode-github-actions",
        "ms-vscode.test-adapter-converter"
      ]
    }
  },
  "postCreateCommand": "cd /workspaces/cps-dynamics-agenticos && git config --global --add safe.directory /workspaces/cps-dynamics-agenticos && echo 'Dev container ready. Run make install to install all dependencies.'",
  "postStartCommand": "echo 'CP'\''S Dynamics Commerce System AgenticOS Development Environment is ready.'"
}
