{
  "name": "CPS Dynamics AgenticOS",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "PATH": "/opt/venv/bin:/usr/local/go/bin:/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "GOPATH": "/go",
    "PYTHONPATH": "/workspaces/CPS-Dynamics-Commerce-System-AgenticOS"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/CPS-Dynamics-Commerce-System-AgenticOS,type=bind",
  "workspaceFolder": "/workspaces/CPS-Dynamics-Commerce-System-AgenticOS",
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "forwardPorts": [
    3000,
    5173,
    5432,
    6379,
    9092,
    8200,
    3001,
    9090
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.analysis.extraPaths": [
          "/workspaces/CPS-Dynamics-Commerce-System-AgenticOS/cps-enterprise-dcs/local-agent/src"
        ],
        "go.gopath": "/go",
        "go.toolsManagement.autoUpdate": true
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "golang.go",
        "ms-python.python",
        "ms-python.black-formatter",
        "charliermarsh.ruff",
        "zxh404.vscode-proto3",
        "ms-azuretools.vscode-docker",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "redhat.vscode-yaml",
        "github.vscode-github-actions"
      ]
    }
  },
  "postCreateCommand": "cd /workspaces/CPS-Dynamics-Commerce-System-AgenticOS && git config --global --add safe.directory /workspaces/CPS-Dynamics-Commerce-System-AgenticOS && echo 'Dev container ready. Run make install to install all dependencies.'",
  "postStartCommand": "echo 'CPS Dynamics AgenticOS Development Environment is ready.'"
}
